{
  "_doc": "Node type registry for the dataflow editor. Each op type declares typed connection slots (ports), a glyph/icon, a one-line description, and a param schema. Ports are drawn as CIRCLES (connection slots): inputs on the leading edge, outputs on the trailing edge (top/bottom for dir=down, left/right for dir=right). role drives slot color + legal connections. Composites (Attention/SwiGLU/Block) derive ports from their subgraph in/out.",
  "roles": {
    "tokens": { "color": "secondary", "desc": "integer token ids [B,T]" },
    "resid":  { "color": "accent1",   "desc": "residual-stream activations [B,T,d]" },
    "hidden": { "color": "primary",   "desc": "intermediate activations" },
    "scores": { "color": "accent2",   "desc": "attention scores [B,h,T,T]" },
    "logits": { "color": "accent1",   "desc": "output logits [B,T,vocab]" }
  },
  "types": {
    "TokenEmbedding": { "cat": "embed",  "glyph": "⊞", "icon": "embed",  "label": "Token Embedding", "desc": "look up a learned vector per token id",
      "in":  [{ "name": "tokens", "role": "tokens" }], "out": [{ "name": "x", "role": "resid" }],
      "params": { "d": "int", "vocab": "int" } },
    "Unembedding":    { "cat": "embed",  "glyph": "⊟", "icon": "embed",  "label": "Unembedding + Softmax", "desc": "project the residual stream to vocab logits (optionally tied to the embedding)",
      "in":  [{ "name": "x", "role": "resid" }], "out": [{ "name": "logits", "role": "logits" }],
      "params": { "tie": "ref?" } },
    "RMSNorm":        { "cat": "norm",   "glyph": "‖·‖", "icon": "norm", "label": "RMSNorm", "desc": "root-mean-square layer normalisation",
      "in":  [{ "name": "x", "role": "resid" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": { "eps": "float" } },
    "LayerNorm":      { "cat": "norm",   "glyph": "‖·‖", "icon": "norm", "label": "LayerNorm", "desc": "mean/variance layer normalisation",
      "in":  [{ "name": "x", "role": "resid" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": { "eps": "float" } },
    "Linear":         { "cat": "linear", "glyph": "W·", "icon": "linear","label": "Linear", "desc": "learned affine projection y = xWᵀ (+b)",
      "in":  [{ "name": "x", "role": "hidden" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": { "out": "dim-expr", "bias": "bool" } },
    "MatMul":         { "cat": "tensor", "glyph": "⊗", "icon": "matmul","label": "MatMul", "desc": "batched matrix product (optionally transpose B, scale)",
      "in":  [{ "name": "a", "role": "hidden" }, { "name": "b", "role": "hidden" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": { "transpose_b": "bool", "scale": "expr" } },
    "Add":            { "cat": "merge",  "glyph": "⊕", "icon": "add",   "label": "Add", "desc": "elementwise sum — the residual join",
      "in":  [{ "name": "a", "role": "resid" }, { "name": "b", "role": "resid" }], "out": [{ "name": "y", "role": "resid" }],
      "params": {} },
    "Mul":            { "cat": "merge",  "glyph": "⊙", "icon": "mul",   "label": "Mul", "desc": "elementwise (Hadamard) product — the SwiGLU gate",
      "in":  [{ "name": "a", "role": "hidden" }, { "name": "b", "role": "hidden" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": {} },
    "Scale":          { "cat": "tensor", "glyph": "×s", "icon": "scale","label": "Scale", "desc": "multiply by a scalar/constant",
      "in":  [{ "name": "x", "role": "hidden" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": { "factor": "expr" } },
    "Softmax":        { "cat": "act",    "glyph": "σ", "icon": "softmax","label": "Softmax", "desc": "normalise along an axis into a distribution",
      "in":  [{ "name": "x", "role": "scores" }], "out": [{ "name": "y", "role": "scores" }],
      "params": { "axis": "int" } },
    "SiLU":           { "cat": "act",    "glyph": "ƒ", "icon": "act",   "label": "SiLU", "desc": "x·sigmoid(x) activation",
      "in":  [{ "name": "x", "role": "hidden" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": {} },
    "GELU":           { "cat": "act",    "glyph": "ƒ", "icon": "act",   "label": "GELU", "desc": "gaussian-error linear unit activation",
      "in":  [{ "name": "x", "role": "hidden" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": {} },
    "Rope":           { "cat": "pos",    "glyph": "↻θ", "icon": "rope", "label": "RoPE", "desc": "rotary position embedding applied to q/k",
      "in":  [{ "name": "x", "role": "hidden" }], "out": [{ "name": "y", "role": "hidden" }],
      "params": { "theta": "float" } },
    "Attention":      { "cat": "block",  "glyph": "⊛", "icon": "attn",  "label": "Attention", "desc": "multi/grouped-query self-attention (a composite — open to see Q/K/V→softmax→·V)",
      "in":  [{ "name": "x", "role": "resid" }], "out": [{ "name": "x", "role": "resid" }],
      "params": { "kind": "enum:mha|gqa|mla", "n_q": "int", "n_kv": "int" }, "composite": true },
    "SwiGLU":         { "cat": "block",  "glyph": "⧉", "icon": "mlp",   "label": "SwiGLU MLP", "desc": "gated feed-forward (a composite — open to see gate·up→down)",
      "in":  [{ "name": "x", "role": "resid" }], "out": [{ "name": "x", "role": "resid" }],
      "params": { "mult": "int" }, "composite": true },
    "Block":          { "cat": "block",  "glyph": "▦", "icon": "block", "label": "Transformer Block", "desc": "one residual block (a composite — open to see norm→attn→add→norm→mlp→add)",
      "in":  [{ "name": "x", "role": "resid" }], "out": [{ "name": "x", "role": "resid" }],
      "params": {}, "composite": true }
  },
  "palette": [
    { "group": "Embed",      "types": ["TokenEmbedding", "Unembedding"] },
    { "group": "Blocks",     "types": ["Block", "Attention", "SwiGLU"] },
    { "group": "Norm",       "types": ["RMSNorm", "LayerNorm"] },
    { "group": "Linear/Tensor","types": ["Linear", "MatMul", "Scale"] },
    { "group": "Act",        "types": ["Softmax", "SiLU", "GELU"] },
    { "group": "Merge",      "types": ["Add", "Mul"] },
    { "group": "Pos",        "types": ["Rope"] }
  ]
}
